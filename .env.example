# Leave EMPTY in development: requests go through the Vite proxy (/api -> VITE_PROXY_TARGET), so no CORS setup is needed.
# REQUIRED for production builds: the public backend origin, e.g. https://api.example.com (no trailing slash, no /api/v1).
VITE_API_URL=
# Where the Vite dev proxy forwards /api (your FastAPI server)
VITE_PROXY_TARGET=http://localhost:8000
VITE_APP_NAME=Bonayon
VITE_DEFAULT_LANGUAGE=en
VITE_ENABLE_PWA=false
